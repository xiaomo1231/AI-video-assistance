{
  "name": "mojian",
  "productName": "墨剪",
  "version": "0.1.0",
  "description": "本地 AI 视频工作台：分镜、提示词、配音、配乐、剪辑、调色、工作流",
  "main": "electron/main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.js & ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "build": "vite build --config vite.config.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "isomorphic-git": "^1.29.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "app.mojian.studio",
    "productName": "墨剪",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "core/**",
      "dist/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "resources/icon.png"
    }
  }
}
